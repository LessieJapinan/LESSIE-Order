<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Canteen Ordering System</title>
<style>
  *{box-sizing:border-box;font-family:Arial,sans-serif}
  body{margin:0;background:#fff7ed}
  header{background:#ea580c;color:#fff;padding:15px;text-align:center}
  header h1{margin:0;font-size:22px}
  header p{margin:5px 0 0;font-size:13px;opacity:.9}
  .container{display:flex;gap:15px;padding:15px;max-width:1000px;margin:auto;flex-wrap:wrap}
  .menu{flex:2;min-width:280px}
  .cart{flex:1;min-width:260px;background:#fff;border-radius:12px;padding:15px;height:fit-content;box-shadow:0 2px 10px rgba(0,0,0,.1);position:sticky;top:15px}
  .category{margin-bottom:20px}
  .category h2{font-size:18px;border-left:5px solid #ea580c;padding-left:8px}
  .item{display:flex;justify-content:space-between;align-items:center;background:#fff;padding:12px;border-radius:10px;margin-bottom:10px;box-shadow:0 1px 5px rgba(0,0,0,.08)}
  .item b{font-size:15px}
  .item span{font-size:13px;color:#666}
  .price{color:#ea580c;font-weight:bold}
  button{border:none;cursor:pointer;border-radius:8px;padding:8px 12px}
  .add{background:#ea580c;color:#fff;font-weight:bold}
  .qty-btn{background:#eee;padding:5px 10px}
  .cart-item{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #eee;font-size:14px}
  input,select{width:100%;padding:10px;margin:8px 0;border:1px solid #ddd;border-radius:8px}
  .total{font-size:18px;font-weight:bold;display:flex;justify-content:space-between;margin-top:10px}
  .checkout{background:#16a34a;color:#fff;width:100%;padding:12px;font-size:16px;font-weight:bold;margin-top:10px}
  .clear{background:#fee2e2;color:#dc2626;width:100%;margin-top:8px}
  .success{background:#dcfce7;padding:12px;border-radius:8px;margin-top:10px;display:none;text-align:center}
  @media(max-width:700px){.container{flex-direction:column}}
</style>
</head>
<body>

<header>
  <h1>🍔 School Canteen Ordering System</h1>
  <p>Order now, pick up later - No pila!</p>
</header>

<div class="container">
  <!-- MENU -->
  <div class="menu" id="menu"></div>

  <!-- CART -->
  <div class="cart">
    <h3>🛒 Your Order</h3>
    <div id="cartItems">No items yet.</div>
    <div class="total"><span>Total:</span><span id="total">₱0.00</span></div>

    <input type="text" id="customerName" placeholder="Your Name (e.g. Juan Dela Cruz)">
    <select id="orderType">
      <option value="Dine In">Dine In</option>
      <option value="Take Out">Take Out</option>
      <option value="Pick Up">Pick Up</option>
    </select>

    <button class="checkout" onclick
